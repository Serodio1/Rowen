{
  "compilerOptions": {
    /* tsc -b always writes a small build-info file: keep it out of the project folder */
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    /* DOM: the end-to-end tests run some of their code in the page */
    "lib": ["ES2023", "DOM"],
    "module": "nodenext",
    "types": ["node"],
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,

    /* Bundler mode */
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Type-checking */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "vite.config.ts",
    "eslint.config.js",
    "playwright.config.ts",
    "e2e"
  ]
}
