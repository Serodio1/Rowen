# Only install versions published at least 14 days ago: a malicious release
# is usually found and taken down within days. Needs npm 11.10.0 or later.
min-release-age=14
# Never run the scripts that packages ask to run when they are installed:
# that is how malicious releases usually run their code. Our own scripts
# (npm run lint, npm test, ...) still run, but not their pre/post scripts
# (such as a "prebuild"): put such a step in the script itself.
ignore-scripts=true
# Refuse to install with a Node.js or npm version outside "engines" in
# package.json, rather than install with a version this project was not
# checked with.
engine-strict=true
