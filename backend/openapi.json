{
  "openapi": "3.1.0",
  "info": {
    "title": "Rowen",
    "version": "0.2.0"
  },
  "paths": {
    "/decks": {
      "get": {
        "summary": "List Decks",
        "description": "Return the decks the player can choose from to start a match.\n\nThe AI plays another one of them.",
        "operationId": "list_decks",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Decks"
                }
              }
            }
          }
        }
      }
    },
    "/matches": {
      "post": {
        "summary": "Create Match",
        "description": "Start a match against the AI, which plays another deck.\n\nIf the AI starts, it plays until it is the player's turn, and the events\nof its moves come with the match. The ``Location`` header of the response\nholds the address of the match.",
        "operationId": "create_match",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewMatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Played"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/matches/{match_id}": {
      "get": {
        "summary": "Get Match",
        "description": "Return a match as the player may see it.",
        "operationId": "get_match",
        "parameters": [
          {
            "name": "match_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Match Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Match"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        }
      }
    },
    "/matches/{match_id}/actions": {
      "post": {
        "summary": "Play",
        "description": "Play the player's action, and then let the AI answer.\n\nThe action is one of the legal actions in the player's view, sent back as\nit is, with the version of the match that came with that view. If the\nmatch is at another version, the answer is a 409 and the match doesn't\nchange: get it again to see where it is. That is so also when another\nrequest for the same match is played first, while this one is. If the\naction isn't legal now, the answer is a 409 too.",
        "operationId": "play",
        "parameters": [
          {
            "name": "match_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Match Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Move"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Played"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Ability": {
        "type": "string",
        "enum": [
          "agile",
          "spy",
          "medic",
          "muster",
          "bond",
          "inspire"
        ],
        "title": "Ability",
        "description": "A unit ability (rules, section 7). A unit has at most one."
      },
      "Action": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/PlayUnit"
          },
          {
            "$ref": "#/components/schemas/PlaySpecial"
          },
          {
            "$ref": "#/components/schemas/PlayHorn"
          },
          {
            "$ref": "#/components/schemas/PlayScarecrow"
          },
          {
            "$ref": "#/components/schemas/Pass"
          },
          {
            "$ref": "#/components/schemas/Revive"
          },
          {
            "$ref": "#/components/schemas/Redraw"
          },
          {
            "$ref": "#/components/schemas/EndRedraw"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "end_redraw": "#/components/schemas/EndRedraw",
            "pass": "#/components/schemas/Pass",
            "play_horn": "#/components/schemas/PlayHorn",
            "play_scarecrow": "#/components/schemas/PlayScarecrow",
            "play_special": "#/components/schemas/PlaySpecial",
            "play_unit": "#/components/schemas/PlayUnit",
            "redraw": "#/components/schemas/Redraw",
            "revive": "#/components/schemas/Revive"
          }
        }
      },
      "Card": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/UnitCard"
          },
          {
            "$ref": "#/components/schemas/SpecialCard"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "special": "#/components/schemas/SpecialCard",
            "unit": "#/components/schemas/UnitCard"
          }
        }
      },
      "CardRedrawn": {
        "properties": {
          "type": {
            "type": "string",
            "const": "card_redrawn",
            "title": "Type"
          },
          "player": {
            "type": "integer",
            "title": "Player"
          },
          "card": {
            "type": "string",
            "title": "Card"
          },
          "drawn": {
            "type": "string",
            "title": "Drawn"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "player",
          "card",
          "drawn"
        ],
        "title": "CardRedrawn",
        "description": "The player swapped a card before round 1: ``engine.CardRedrawn``.\n\nThe player only gets this for their own cards. For the opponent's, they get\n``OpponentRedrew``."
      },
      "CardsDrawn": {
        "properties": {
          "type": {
            "type": "string",
            "const": "cards_drawn",
            "title": "Type"
          },
          "player": {
            "type": "integer",
            "title": "Player"
          },
          "cards": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Cards"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "player",
          "cards"
        ],
        "title": "CardsDrawn",
        "description": "The player drew cards: ``engine.CardsDrawn``.\n\nThe player only gets this for their own cards. For the opponent's, they get\n``OpponentDrew``."
      },
      "DeckSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "DeckSummary",
        "description": "A deck the player can choose: its id, to start a match, and its name."
      },
      "Decks": {
        "properties": {
          "decks": {
            "items": {
              "$ref": "#/components/schemas/DeckSummary"
            },
            "type": "array",
            "title": "Decks"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decks"
        ],
        "title": "Decks",
        "description": "The decks a player can choose from, in alphabetical order of their ids.\n\nThe answer is an object with a list in it, not a bare list, like every\nother answer of the API, so it can get more fields later."
      },
      "EndRedraw": {
        "properties": {
          "type": {
            "type": "string",
            "const": "end_redraw",
            "title": "Type"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type"
        ],
        "title": "EndRedraw",
        "description": "Swap no more cards: ``engine.EndRedraw``."
      },
      "Error": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "Error",
        "description": "What the API sends when it turns a request down.\n\n``code`` says what went wrong, for the browser, and ``message`` says it in\nwords, for a person. A message may say where in the request the mistake\nis, even with the name of a field the API doesn't know, but it never holds\na value from the request: a value can be nested too deep to send back.\nA request over 16 KB never reaches the API: nginx turns it down with a\npage of its own, not this error."
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "invalid_request",
          "unknown_deck",
          "match_not_found",
          "illegal_action",
          "match_changed",
          "not_found",
          "method_not_allowed",
          "server_error",
          "too_many_requests"
        ]
      },
      "EventView": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/UnitPlayed"
          },
          {
            "$ref": "#/components/schemas/UnitRevived"
          },
          {
            "$ref": "#/components/schemas/UnitMustered"
          },
          {
            "$ref": "#/components/schemas/CardsDrawn"
          },
          {
            "$ref": "#/components/schemas/WeatherPlayed"
          },
          {
            "$ref": "#/components/schemas/WeatherCleared"
          },
          {
            "$ref": "#/components/schemas/HornPlayed"
          },
          {
            "$ref": "#/components/schemas/ScarecrowPlayed"
          },
          {
            "$ref": "#/components/schemas/WildfirePlayed"
          },
          {
            "$ref": "#/components/schemas/UnitDestroyed"
          },
          {
            "$ref": "#/components/schemas/PlayerPassed"
          },
          {
            "$ref": "#/components/schemas/RoundEnded"
          },
          {
            "$ref": "#/components/schemas/MatchEnded"
          },
          {
            "$ref": "#/components/schemas/CardRedrawn"
          },
          {
            "$ref": "#/components/schemas/RedrawEnded"
          },
          {
            "$ref": "#/components/schemas/OpponentDrew"
          },
          {
            "$ref": "#/components/schemas/OpponentRedrew"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "card_redrawn": "#/components/schemas/CardRedrawn",
            "cards_drawn": "#/components/schemas/CardsDrawn",
            "horn_played": "#/components/schemas/HornPlayed",
            "match_ended": "#/components/schemas/MatchEnded",
            "opponent_drew": "#/components/schemas/OpponentDrew",
            "opponent_redrew": "#/components/schemas/OpponentRedrew",
            "player_passed": "#/components/schemas/PlayerPassed",
            "redraw_ended": "#/components/schemas/RedrawEnded",
            "round_ended": "#/components/schemas/RoundEnded",
            "scarecrow_played": "#/components/schemas/ScarecrowPlayed",
            "unit_destroyed": "#/components/schemas/UnitDestroyed",
            "unit_mustered": "#/components/schemas/UnitMustered",
            "unit_played": "#/components/schemas/UnitPlayed",
            "unit_revived": "#/components/schemas/UnitRevived",
            "weather_cleared": "#/components/schemas/WeatherCleared",
            "weather_played": "#/components/schemas/WeatherPlayed",
            "wildfire_played": "#/components/schemas/WildfirePlayed"
          }
        }
      },
      "HornPlayed": {
        "properties": {
          "type": {
            "type": "string",
            "const": "horn_played",
            "title": "Type"
          },
          "player": {
            "type": "integer",
            "title": "Player"
          },
          "card": {
            "type": "string",
            "title": "Card"
          },
          "row": {
            "$ref": "#/components/schemas/Row"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "player",
          "card",
          "row"
        ],
        "title": "HornPlayed",
        "description": "A player played a War Horn: ``engine.HornPlayed``."
      },
      "Match": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "view": {
            "$ref": "#/components/schemas/PlayerView"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "version",
          "view"
        ],
        "title": "Match",
        "description": "A match as the player may see it: its id, its version and the view.\n\nThe id is all it takes to see and play the match, so only its player gets\nit. The version goes up each time the match changes: a move sends back the\nversion of the view it was chosen from."
      },
      "MatchEnded": {
        "properties": {
          "type": {
            "type": "string",
            "const": "match_ended",
            "title": "Type"
          },
          "winner": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Winner"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "winner"
        ],
        "title": "MatchEnded",
        "description": "A player has no lives left: ``engine.MatchEnded``."
      },
      "Move": {
        "properties": {
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "action": {
            "$ref": "#/components/schemas/Action"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "action"
        ],
        "title": "Move",
        "description": "What the player sends to play: an action, and the version it was chosen at.\n\n``action`` is one of the legal actions of the view, sent back as it is,\nand ``version`` is the version of the match that came with that view. If\nthe match is at another version by then, the move isn't played."
      },
      "NewMatch": {
        "properties": {
          "deck": {
            "type": "string",
            "title": "Deck"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "deck"
        ],
        "title": "NewMatch",
        "description": "What the player sends to start a match: the id of their deck."
      },
      "OpponentDrew": {
        "properties": {
          "type": {
            "type": "string",
            "const": "opponent_drew",
            "title": "Type"
          },
          "player": {
            "type": "integer",
            "title": "Player"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "player",
          "count"
        ],
        "title": "OpponentDrew",
        "description": "The opponent drew cards, but not which: ``engine.OpponentDrew``."
      },
      "OpponentRedrew": {
        "properties": {
          "type": {
            "type": "string",
            "const": "opponent_redrew",
            "title": "Type"
          },
          "player": {
            "type": "integer",
            "title": "Player"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "player"
        ],
        "title": "OpponentRedrew",
        "description": "The opponent swapped a card, but not which: ``engine.OpponentRedrew``."
      },
      "Pass": {
        "properties": {
          "type": {
            "type": "string",
            "const": "pass",
            "title": "Type"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type"
        ],
        "title": "Pass",
        "description": "Take no more turns this round: ``engine.Pass``."
      },
      "PlayHorn": {
        "properties": {
          "type": {
            "type": "string",
            "const": "play_horn",
            "title": "Type"
          },
          "card": {
            "type": "string",
            "title": "Card"
          },
          "row": {
            "$ref": "#/components/schemas/Row"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "card",
          "row"
        ],
        "title": "PlayHorn",
        "description": "Play a War Horn: ``engine.PlayHorn``."
      },
      "PlayScarecrow": {
        "properties": {
          "type": {
            "type": "string",
            "const": "play_scarecrow",
            "title": "Type"
          },
          "card": {
            "type": "string",
            "title": "Card"
          },
          "row": {
            "$ref": "#/components/schemas/Row"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "card",
          "row",
          "unit"
        ],
        "title": "PlayScarecrow",
        "description": "Play a Scarecrow in place of a unit: ``engine.PlayScarecrow``."
      },
      "PlaySpecial": {
        "properties": {
          "type": {
            "type": "string",
            "const": "play_special",
            "title": "Type"
          },
          "card": {
            "type": "string",
            "title": "Card"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "card"
        ],
        "title": "PlaySpecial",
        "description": "Play a special card that needs no choice: ``engine.PlaySpecial``."
      },
      "PlayUnit": {
        "properties": {
          "type": {
            "type": "string",
            "const": "play_unit",
            "title": "Type"
          },
          "card": {
            "type": "string",
            "title": "Card"
          },
          "row": {
            "$ref": "#/components/schemas/Row"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "card",
          "row"
        ],
        "title": "PlayUnit",
        "description": "Play a unit from the hand: ``engine.PlayUnit``."
      },
      "Played": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "view": {
            "$ref": "#/components/schemas/PlayerView"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/EventView"
            },
            "type": "array",
            "title": "Events"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "version",
          "view",
          "events"
        ],
        "title": "Played",
        "description": "A match after moves were played in it, and what happened.\n\n``events`` holds the events of those moves, in order, as the player may see\nthem: in a new match, those of the AI's first moves, if it starts (none if\nthe player does); after the player's action, those of the action and then\nthose of the AI's answer."
      },
      "PlayerPassed": {
        "properties": {
          "type": {
            "type": "string",
            "const": "player_passed",
            "title": "Type"
          },
          "player": {
            "type": "integer",
            "title": "Player"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "player"
        ],
        "title": "PlayerPassed",
        "description": "A player passed: ``engine.PlayerPassed``."
      },
      "PlayerView": {
        "properties": {
          "player": {
            "type": "integer",
            "title": "Player"
          },
          "hand": {
            "items": {
              "$ref": "#/components/schemas/Card"
            },
            "type": "array",
            "title": "Hand"
          },
          "players": {
            "prefixItems": [
              {
                "$ref": "#/components/schemas/SideView"
              },
              {
                "$ref": "#/components/schemas/SideView"
              }
            ],
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Players"
          },
          "current": {
            "type": "integer",
            "title": "Current"
          },
          "round": {
            "type": "integer",
            "title": "Round"
          },
          "reviving": {
            "type": "boolean",
            "title": "Reviving"
          },
          "legal_actions": {
            "items": {
              "$ref": "#/components/schemas/Action"
            },
            "type": "array",
            "title": "Legal Actions"
          },
          "match_over": {
            "type": "boolean",
            "title": "Match Over"
          },
          "winner": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Winner"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "player",
          "hand",
          "players",
          "current",
          "round",
          "reviving",
          "legal_actions",
          "match_over",
          "winner"
        ],
        "title": "PlayerView",
        "description": "What one player may see of a match, as ``engine.PlayerView`` describes it."
      },
      "Redraw": {
        "properties": {
          "type": {
            "type": "string",
            "const": "redraw",
            "title": "Type"
          },
          "card": {
            "type": "string",
            "title": "Card"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "card"
        ],
        "title": "Redraw",
        "description": "Swap a card before round 1: ``engine.Redraw``."
      },
      "RedrawEnded": {
        "properties": {
          "type": {
            "type": "string",
            "const": "redraw_ended",
            "title": "Type"
          },
          "player": {
            "type": "integer",
            "title": "Player"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "player"
        ],
        "title": "RedrawEnded",
        "description": "A player is done redrawing: ``engine.RedrawEnded``."
      },
      "Revive": {
